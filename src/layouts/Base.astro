---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import ThemeToggle from "../components/ThemeToggle.astro";
import LangToggle from "../components/LangToggle.astro";
import { getSite, localePath, otherLang, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /* Path padanan halaman ini di bahasa lain, untuk tombol bahasa dan
     <link hreflang>. Tanpa ini tombol bahasa menuju beranda bahasa lain. */
  altPath?: string;
  title?: string;
  description?: string;
  ogImage?: string;
  /* Landing saja: tautan seksi, menu mobile, rel indikator samping,
     dan footer yang menyatu di seksi Kontak. Halaman lain memakai nav
     ringkas dan footer biasa. */
  landing?: boolean;
}

const { lang, altPath, title, description, ogImage, landing = false } =
  Astro.props;
const site = getSite(lang);
const ui = site.ui;
const alt = otherLang(lang);
const altHref = altPath ?? localePath(alt, "/");

const pageTitle = title ? `${site.meta.siteName} — ${title}` : site.meta.siteName;
const pageDescription = description ?? site.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.meta.url);
const altUrl = new URL(altHref, canonical);
const ogUrl = ogImage ? new URL(ogImage, canonical) : null;

const navLinks: { label: string; href: string }[] = landing ? site.nav : [];
const home = localePath(lang, "/");
---

<!doctype html>
<html lang={lang} class:list={[landing && "landing-page"]}>
  <head>
    {/* Anti-kedip tema + penanda .js. Keduanya dipasang sebelum body
        dirender: .js menyembunyikan elemen yang hanya berarti dengan JS
        (dan sebaliknya) tanpa lompatan tata letak.

        View Transitions menukar <html> dengan milik halaman baru tanpa
        reload, jadi atribut yang sama dipasang lagi ke dokumen baru
        sebelum ditukar — tanpa ini tema berkedip ke default. */}
    <script is:inline>
      (function () {
        function apply(doc) {
          var root = doc.documentElement;
          root.classList.add("js");
          try {
            var t = localStorage.getItem("theme");
            if (!t)
              t = matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
            root.dataset.theme = t;
          } catch (e) {}
        }
        apply(document);
        document.addEventListener("astro:before-swap", function (e) {
          apply(e.newDocument);
        });
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={alt} href={altUrl} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.meta.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "id" ? "id_ID" : "en_US"} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta
      name="twitter:card"
      content={ogUrl ? "summary_large_image" : "summary"}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    />

    {/* Pindah halaman (termasuk ganti bahasa) tanpa memuat ulang
        dokumen: halaman baru diambil di latar lalu ditukar dengan
        transisi pudar. Bawaan Astro, bukan dependency tambahan.
        Transisinya otomatis mati di bawah prefers-reduced-motion. */}
    <ClientRouter />
  </head>

  <body class="flex min-h-screen flex-col">
    {/*
      `sticky`, bukan `fixed`: tinggi nav berbeda antara layar sempit
      tanpa JS (dua baris) dan dengan JS (satu baris + hamburger). Sticky
      tetap ikut alur dokumen, jadi tidak ada padding yang perlu ditebak.
    */}
    <header class="site-header">
      <nav class="container-page site-nav" aria-label={ui.navLabel}>
        <a href={landing ? "#hero" : home} class="brand">
          <span class="brand-dot" aria-hidden="true"></span>
          <span class="brand-name">{site.meta.siteName}</span>
          <span class="brand-expansion">{site.meta.siteNameExpansion}</span>
        </a>

        {
          navLinks.length > 0 && (
            /*
              Tanpa JS: jatuh ke baris kedua di layar sempit dan bisa
              digeser horizontal. Dengan JS: disembunyikan di layar sempit,
              diganti tombol menu di bawah.
            */
            <ul class="nav-links">
              {navLinks.map((link) => (
                <li class="shrink-0">
                  <a
                    href={link.href}
                    class="nav-link"
                    data-nav={link.href.slice(1)}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        <div class="nav-controls">
          <LangToggle
            href={altHref}
            lang={alt}
            label={ui.langSwitch.label}
            srLabel={ui.langSwitch.srLabel}
          />
          <ThemeToggle toLight={ui.themeToLight} toDark={ui.themeToDark} />
          {
            navLinks.length > 0 && (
              <button
                type="button"
                class="icon-btn js-only md:hidden"
                aria-expanded="false"
                aria-controls="nav-drawer"
                data-menu-toggle
                data-label-open={ui.menuOpen}
                data-label-close={ui.menuClose}
                aria-label={ui.menuOpen}
              >
                <svg
                  aria-hidden="true"
                  class="menu-icon-open"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                >
                  <path d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <svg
                  aria-hidden="true"
                  class="menu-icon-close"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                >
                  <path d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            )
          }
        </div>
      </nav>

      {
        navLinks.length > 0 && (
          <div id="nav-drawer" class="nav-drawer md:hidden" hidden>
            <ul class="container-page">
              {navLinks.map((link) => (
                <li>
                  <a href={link.href} class="nav-drawer-link">
                    <span>{link.label}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </header>

    {
      landing && (
        <nav class="side-rail" aria-label={ui.railLabel}>
          {[{ label: site.hero.railLabel, href: "#hero" }, ...navLinks].map(
            (link) => (
              <a href={link.href} class="side-rail-link" data-nav={link.href.slice(1)}>
                <span class="side-rail-label">{link.label}</span>
                <span class="side-rail-dot" aria-hidden="true" />
              </a>
            ),
          )}
        </nav>
      )
    }

    <main class="flex-1">
      <slot />
    </main>

    {
      !landing && (
        <footer class="border-t border-line">
          <div class="container-page py-8 text-center">
            <p class="u-mono text-muted">{site.footer.text}</p>
          </div>
        </footer>
      )
    }

    {/* Selalu dirender (script memeriksa sendiri apakah tombol menu ada),
        supaya tetap tersedia saat pindah dari halaman detail ke landing
        lewat View Transitions. */}
    <script>
      // Menu mobile. Tanpa JS tombolnya tidak tampil dan daftar tautan
      // tetap terlihat sebagai baris yang bisa digeser. Dijalankan di
      // setiap `astro:page-load` karena View Transitions tidak memuat
      // ulang script; listener document dilepas sebelum pindah halaman.
      document.addEventListener("astro:page-load", () => {
        const toggle = document.querySelector<HTMLButtonElement>(
          "[data-menu-toggle]",
        );
        const drawer = document.getElementById("nav-drawer");
        if (!toggle || !drawer) return;
        const ac = new AbortController();
        document.addEventListener("astro:before-swap", () => ac.abort(), {
          once: true,
        });
        const setOpen = (open: boolean) => {
          drawer.hidden = !open;
          toggle.setAttribute("aria-expanded", String(open));
          toggle.setAttribute(
            "aria-label",
            (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ??
              "",
          );
        };
        toggle.addEventListener("click", () => setOpen(drawer.hidden));
        drawer
          .querySelectorAll("a")
          .forEach((a) => a.addEventListener("click", () => setOpen(false)));
        document.addEventListener(
          "keydown",
          (e) => {
            if (e.key === "Escape" && !drawer.hidden) {
              setOpen(false);
              toggle.focus();
            }
          },
          { signal: ac.signal },
        );
      });
    </script>
  </body>
</html>
