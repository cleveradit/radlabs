---
import type { CollectionEntry } from "astro:content";
import { catalog, getSite, localePath, type Lang } from "../i18n";

// Kartu penelitian: notasi katalog → judul + panah → ringkasan → tag
// stack → garis → periode, status repo, dan ajakan membuka lembar lab.
//
// Seluruh kartu adalah tautan ke halaman detail (tautan meregang di
// judul). Dengan JS, klik biasa membuka modal ringkasan (<dialog>) yang
// tombolnya menuju halaman detail; klik dengan modifier (tab baru dsb.)
// tetap mengikuti tautan.
interface Props {
  entry: CollectionEntry<"penelitian">;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const d = entry.data;
const p = getSite(lang).penelitian;

const href = localePath(lang, `/penelitian/${d.slug}/`);
const code = catalog(p.catalogPrefix, d.order);
const status = d.statusShort ?? d.status;
---

<article class="card card-hover group relative flex flex-col">
  {/* Baris notasi. Status dibiarkan membungkus, tidak dipotong. Teks
      yang terpotong hanya bisa dibaca lewat tooltip `title`, yang tidak
      bisa dibuka di perangkat sentuh. */}
  <div class="u-mono mb-3 flex items-start justify-between gap-3 text-[11px] text-muted">
    <span class="catalog-chip">{code}</span>
    <span class="flex min-w-0 items-center gap-1.5 text-right">
      <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-accent"></span>
      <span>{status}</span>
    </span>
  </div>

  <div class="flex items-start justify-between gap-3">
    <h3 class="card-title transition-colors group-hover:text-accent">
      {/* Tautan meregang menutupi seluruh kartu lewat ::after untuk menghindari
          <a> bersarang dengan tautan repo di bawah. */}
      <a
        href={href}
        data-case-open={`case-${lang}-${d.slug}`}
        class="text-inherit no-underline after:absolute after:inset-0 after:rounded-[inherit] after:content-['']"
        >{d.title}</a
      >
    </h3>
    <span
      aria-hidden="true"
      class="u-mono shrink-0 text-muted transition-colors group-hover:text-accent"
      >↗</span
    >
  </div>

  <p class="mt-2 text-sm text-muted">{d.summary}</p>

  <div class="mt-auto border-t border-line pt-3">
    <ul class="mt-1 mb-3 flex flex-wrap gap-1.5">
      {d.stack.map((tag) => <li class="pill">{tag}</li>)}
    </ul>

    <div class="u-mono flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-[11px] text-muted">
      <span>{d.period}</span>
      <span class="flex items-center gap-3">
        {
          d.repo ? (
            // z-10 mengangkatnya di atas tautan kartu yang meregang.
            <a
              href={d.repo}
              rel="noopener"
              class="relative z-10 text-muted no-underline hover:text-accent hover:underline"
            >
              {p.repoLabel}
            </a>
          ) : (
            <span>{p.privateRepoLabel}</span>
          )
        }
        <span aria-hidden="true" class="js-only text-accent">{p.cardAction}</span>
      </span>
    </div>
  </div>
</article>
