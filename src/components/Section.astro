---
// Seksi landing: dua kolom di ≥1024px. Kolom kiri berisi kepala seksi
// (nomor // eyebrow, judul, deskripsi, lalu slot `aside`) yang menempel
// di bawah nav selama kolom kanan di-scroll. Di layar sempit keduanya
// menumpuk dan kepala tidak menempel.
//
// `index` diberikan oleh halaman, bukan ditulis di content/. Nomornya
// mengikuti urutan seksi yang benar-benar dirender, jadi tidak pernah
// ada nomor yang bolong kalau ada seksi ditambah atau dihapus.
//
// `alt` menyalakan latar --sunken. Seksi diselang-seling supaya batas
// antar-bagian terbaca.
//
// `wideHead` melebarkan kolom kepala dari 4 ke 5 dari 12 kolom (dipakai
// Pengalaman, yang menaruh tab di kolom itu).
//
// `stickyTitle`: yang menempel hanya blok judul (nomor, judul,
// deskripsi), bukan seluruh kolom kepala. Isi slot `aside` di bawahnya
// ikut tergulir biasa dan lewat di bawah judul. Tanpa prop ini seluruh
// kolom kepala yang menempel.
//
// Slot `backdrop` untuk hiasan latar; slot `after` untuk baris penutup
// di bawah grid (footer di seksi Kontak), didorong ke dasar seksi.
interface Props {
  id: string;
  index: number;
  eyebrow: string;
  title: string;
  description?: string;
  alt?: boolean;
  wideHead?: boolean;
  stickyTitle?: boolean;
}

const {
  id,
  index,
  eyebrow,
  title,
  description,
  alt = false,
  wideHead = false,
  stickyTitle = false,
} = Astro.props;
const num = String(index).padStart(2, "0");
const hasAfter = Astro.slots.has("after");
---

<section
  id={id}
  data-spy
  class:list={[
    "section",
    alt && "section-alt bg-sunken",
    hasAfter && "section-has-after",
  ]}
>
  <slot name="backdrop" />

  <div class="container-page section-inner">
    <div
      class:list={[
        "section-grid",
        wideHead && "section-grid-wide",
        stickyTitle && "section-grid-sticky-title",
      ]}
    >
      <div class="section-head">
        <div class="section-title-block">
          <p class="u-eyebrow font-semibold text-accent">{num} // {eyebrow}</p>
          <h2 class="section-title">{title}</h2>
          {description && <p class="section-desc">{description}</p>}
        </div>
        <slot name="aside" />
      </div>

      <div class="section-body">
        <slot />
      </div>
    </div>

    {hasAfter && <slot name="after" />}
  </div>
</section>
