---
// Seksi landing: garis atas 1px bertanda ukur, jarak 56px, eyebrow mono
// bernomor di atas isi.
//
// `index` opsional dan diberikan oleh halaman, bukan ditulis di content/ —
// nomornya mengikuti urutan seksi yang benar-benar dirender, jadi tidak
// pernah ada nomor yang bolong kalau ada seksi ditambah atau dihapus.
interface Props {
  eyebrow: string;
  index?: number;
  id?: string;
}

const { eyebrow, index, id } = Astro.props;
const num = index === undefined ? null : String(index).padStart(2, "0");
---

<section id={id} class="border-t border-line">
  <div class="container-page rule-ticks py-[var(--spacing-section)]">
    <h2 class="u-eyebrow">
      {
        num && (
          <>
            <span class="text-accent">{num}</span>
            {/* Pemisah dekoratif — dibaca "slash" oleh pembaca layar
                tanpa menambah makna, jadi disembunyikan. Jarak kanannya
                sengaja dibiarkan diisi spasi asli di markup: tanpa spasi
                itu nama aksesibelnya jadi "01Karya". */}
            <span aria-hidden="true" class="ml-[0.5em]">
              /
            </span>
          </>
        )
      }{/* Spasi eksplisit — Astro memangkas whitespace di antara ekspresi,
           dan tanpa spasi ini nama aksesibelnya terbaca "01Karya". */}
      {num && " "}{eyebrow}
    </h2>
    <div class="mt-6">
      <slot />
    </div>
  </div>
</section>
