---
import type { CollectionEntry } from "astro:content";
import KaryaCard from "./KaryaCard.astro";

interface Props {
  entries: CollectionEntry<"karya">[];
  label: string;
}

const { entries, label } = Astro.props;
---

{
  entries.length === 0 ? null : entries.length === 1 ? (
    <KaryaCard entry={entries[0]} variant="solo" />
  ) : (
    <div
      class="karya-slider"
      data-karya-slider
      role="region"
      aria-label={label}
    >
      <ul
        class="karya-track"
        data-karya-track
        tabindex="0"
        aria-live="off"
      >
        {entries.map((entry) => (
          <li class="karya-slide">
            <KaryaCard entry={entry} variant="grid" />
          </li>
        ))}
      </ul>
    </div>
  )
}

<script is:inline>
  document.querySelectorAll("[data-karya-slider]").forEach((slider) => {
    const track = slider.querySelector("[data-karya-track]");
    if (!(track instanceof HTMLElement) || track.dataset.ready) return;

    const originalSlides = Array.from(track.children).filter(
      (item) => item instanceof HTMLElement,
    );
    if (originalSlides.length < 2) return;

    track.dataset.ready = "true";

    const cloneSlide = (slide) => {
      const clone = slide.cloneNode(true);
      clone.dataset.karyaClone = "";
      clone.setAttribute("aria-hidden", "true");
      clone.querySelectorAll("a, button, [tabindex]").forEach((element) => {
        element.setAttribute("tabindex", "-1");
      });
      return clone;
    };

    const beforeClones = originalSlides.map(cloneSlide);
    const afterClones = originalSlides.map(cloneSlide);
    const beforeFragment = document.createDocumentFragment();
    const afterFragment = document.createDocumentFragment();

    beforeClones.forEach((slide) => beforeFragment.append(slide));
    afterClones.forEach((slide) => afterFragment.append(slide));
    track.prepend(beforeFragment);
    track.append(afterFragment);

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const abortController = new AbortController();
    const listenerOptions = { signal: abortController.signal };
    const speed = 42;

    let setWidth = 0;
    let originalStart = 0;
    let afterStart = 0;
    let animationFrame = 0;
    let previousTime = 0;
    let pointerId = null;
    let startX = 0;
    let startScrollLeft = 0;
    let dragged = false;
    let clickResetTimer = 0;
    const hasKeyboardFocusWithin = () => {
      const activeElement = document.activeElement;
      return (
        activeElement instanceof HTMLElement &&
        slider.contains(activeElement) &&
        activeElement.matches(":focus-visible")
      );
    };
    let focusPaused = hasKeyboardFocusWithin();
    const isInViewport = () => {
      const rect = slider.getBoundingClientRect();
      return rect.bottom > 0 && rect.top < window.innerHeight;
    };
    let inViewport = isInViewport();
    let normalizing = false;

    const measure = (preservePosition = true) => {
      const previousWidth = setWidth;
      const previousOffset = previousWidth
        ? (track.scrollLeft - originalStart) / previousWidth
        : 0;

      const positionInTrack = (element) =>
        element.getBoundingClientRect().left -
        track.getBoundingClientRect().left +
        track.scrollLeft;

      originalStart = positionInTrack(originalSlides[0]);
      afterStart = positionInTrack(afterClones[0]);
      setWidth = afterStart - originalStart;

      if (setWidth <= 0) return;
      track.scrollLeft = preservePosition
        ? originalStart + previousOffset * setWidth
        : originalStart;
    };

    const normalizePosition = () => {
      if (normalizing || setWidth <= 0) return;

      let next = track.scrollLeft;
      let shift = 0;

      while (next < originalStart) {
        next += setWidth;
        shift += setWidth;
      }
      while (next >= afterStart) {
        next -= setWidth;
        shift -= setWidth;
      }

      if (shift === 0) return;
      normalizing = true;
      track.scrollLeft = next;
      if (pointerId !== null) startScrollLeft += shift;
      normalizing = false;
    };

    const shouldAnimate = () =>
      !reducedMotion.matches &&
      !document.hidden &&
      inViewport &&
      pointerId === null &&
      !slider.matches(":hover") &&
      !focusPaused;

    const stopAnimation = () => {
      if (animationFrame) cancelAnimationFrame(animationFrame);
      animationFrame = 0;
      previousTime = 0;
    };

    const animate = (time) => {
      if (!shouldAnimate()) {
        stopAnimation();
        return;
      }

      if (previousTime) {
        const elapsed = Math.min(time - previousTime, 64);
        track.scrollLeft += (speed * elapsed) / 1000;
        normalizePosition();
      }
      previousTime = time;
      animationFrame = requestAnimationFrame(animate);
    };

    const syncAnimation = () => {
      if (!shouldAnimate()) {
        stopAnimation();
        return;
      }
      if (!animationFrame) animationFrame = requestAnimationFrame(animate);
    };

    track.addEventListener(
      "pointerdown",
      (event) => {
        if (event.button !== 0 || pointerId !== null) return;
        pointerId = event.pointerId;
        startX = event.clientX;
        startScrollLeft = track.scrollLeft;
        dragged = false;
        stopAnimation();
      },
      listenerOptions,
    );

    track.addEventListener(
      "pointermove",
      (event) => {
        if (pointerId !== event.pointerId) return;

        const distance = event.clientX - startX;
        if (Math.abs(distance) <= 5) return;

        if (!dragged) {
          dragged = true;
          track.classList.add("is-dragging");
          track.setPointerCapture(pointerId);
        }
        track.scrollLeft = startScrollLeft - distance;
        normalizePosition();
      },
      listenerOptions,
    );

    const finishDrag = (event) => {
      if (pointerId !== event.pointerId) return;

      if (track.hasPointerCapture(pointerId)) {
        track.releasePointerCapture(pointerId);
      }
      pointerId = null;
      track.classList.remove("is-dragging");
      normalizePosition();
      syncAnimation();
      window.clearTimeout(clickResetTimer);
      clickResetTimer = window.setTimeout(() => {
        dragged = false;
      });
    };

    window.addEventListener("pointerup", finishDrag, listenerOptions);
    window.addEventListener("pointercancel", finishDrag, listenerOptions);
    track.addEventListener(
      "scroll",
      normalizePosition,
      { ...listenerOptions, passive: true },
    );
    track.addEventListener(
      "dragstart",
      (event) => event.preventDefault(),
      listenerOptions,
    );
    track.addEventListener(
      "click",
      (event) => {
        if (!dragged) return;
        event.preventDefault();
        event.stopPropagation();
      },
      { ...listenerOptions, capture: true },
    );

    slider.addEventListener("mouseenter", stopAnimation, listenerOptions);
    slider.addEventListener("mouseleave", syncAnimation, listenerOptions);
    slider.addEventListener(
      "focusin",
      (event) => {
        focusPaused =
          event.target instanceof HTMLElement &&
          event.target.matches(":focus-visible");
        if (focusPaused) stopAnimation();
      },
      listenerOptions,
    );
    slider.addEventListener(
      "focusout",
      (event) => {
        if (
          event.relatedTarget instanceof Node &&
          slider.contains(event.relatedTarget)
        )
          return;
        focusPaused = false;
        syncAnimation();
      },
      listenerOptions,
    );
    reducedMotion.addEventListener(
      "change",
      syncAnimation,
      listenerOptions,
    );
    document.addEventListener(
      "visibilitychange",
      syncAnimation,
      listenerOptions,
    );

    const resizeObserver = new ResizeObserver(() => measure());
    resizeObserver.observe(track);

    const intersectionObserver = new IntersectionObserver(
      ([entry]) => {
        inViewport = entry.isIntersecting;
        syncAnimation();
      },
      { threshold: 0.1 },
    );
    intersectionObserver.observe(slider);

    const cleanup = () => {
      stopAnimation();
      window.clearTimeout(clickResetTimer);
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      abortController.abort();
    };

    window.addEventListener(
      "pagehide",
      (event) => {
        if (event.persisted) {
          stopAnimation();
          return;
        }
        cleanup();
      },
      listenerOptions,
    );
    window.addEventListener(
      "pageshow",
      () => {
        pointerId = null;
        dragged = false;
        focusPaused = hasKeyboardFocusWithin();
        inViewport = isInViewport();
        track.classList.remove("is-dragging");
        measure();
        syncAnimation();
      },
      listenerOptions,
    );

    measure(false);
    slider.classList.add("is-enhanced");
    syncAnimation();
  });
</script>
