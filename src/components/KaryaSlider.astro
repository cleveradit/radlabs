---
import type { CollectionEntry } from "astro:content";
import KaryaCard from "./KaryaCard.astro";

interface Props {
  entries: CollectionEntry<"karya">[];
  label: string;
}

const { entries, label } = Astro.props;
---

{
  entries.length === 1 ? (
    <KaryaCard entry={entries[0]} variant="solo" />
  ) : (
    <div
      class="karya-slider"
      data-karya-slider
      role="region"
      aria-label={label}
    >
      <ul
        class="karya-track"
        data-karya-track
        tabindex="0"
        aria-live="off"
      >
        {entries.map((entry) => (
          <li class="karya-slide">
            <KaryaCard entry={entry} variant="grid" />
          </li>
        ))}
      </ul>
    </div>
  )
}

<script is:inline>
  document.querySelectorAll("[data-karya-slider]").forEach((slider) => {
    const track = slider.querySelector("[data-karya-track]");
    if (!(track instanceof HTMLElement) || track.dataset.ready) return;

    track.dataset.ready = "true";

    const slides = Array.from(track.children).filter(
      (item) => item instanceof HTMLElement,
    );
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    let direction = 1;
    let timer;
    let resumeTimer;
    let pointerId = null;
    let startX = 0;
    let startScrollLeft = 0;
    let dragged = false;

    const clearTimers = () => {
      window.clearInterval(timer);
      window.clearTimeout(resumeTimer);
    };

    const stepSize = () => {
      if (slides.length < 2) return track.clientWidth;
      return (
        slides[1].getBoundingClientRect().left -
        slides[0].getBoundingClientRect().left
      );
    };

    const advance = () => {
      const max = track.scrollWidth - track.clientWidth;
      if (max <= 1) return;

      if (track.scrollLeft >= max - 2) direction = -1;
      if (track.scrollLeft <= 2) direction = 1;

      track.scrollTo({
        left: Math.max(
          0,
          Math.min(max, track.scrollLeft + direction * stepSize()),
        ),
        behavior: "smooth",
      });
    };

    const startAutoplay = () => {
      clearTimers();
      if (
        reducedMotion.matches ||
        document.hidden ||
        slides.length < 2 ||
        slider.matches(":hover") ||
        slider.contains(document.activeElement)
      )
        return;
      timer = window.setInterval(advance, 4500);
    };

    const resumeAutoplay = () => {
      clearTimers();
      resumeTimer = window.setTimeout(startAutoplay, 3500);
    };

    track.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;

      pointerId = event.pointerId;
      startX = event.clientX;
      startScrollLeft = track.scrollLeft;
      dragged = false;
      track.classList.add("is-dragging");
      track.setPointerCapture(pointerId);
      clearTimers();
    });

    track.addEventListener("pointermove", (event) => {
      if (pointerId !== event.pointerId) return;

      const distance = event.clientX - startX;
      if (Math.abs(distance) > 5) dragged = true;
      track.scrollLeft = startScrollLeft - distance;
    });

    const finishDrag = (event) => {
      if (pointerId !== event.pointerId) return;

      if (track.hasPointerCapture(pointerId)) {
        track.releasePointerCapture(pointerId);
      }
      pointerId = null;
      track.classList.remove("is-dragging");
      resumeAutoplay();
      window.setTimeout(() => {
        dragged = false;
      });
    };

    track.addEventListener("pointerup", finishDrag);
    track.addEventListener("pointercancel", finishDrag);
    track.addEventListener("dragstart", (event) => event.preventDefault());
    track.addEventListener(
      "click",
      (event) => {
        if (!dragged) return;
        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );

    slider.addEventListener("mouseenter", clearTimers);
    slider.addEventListener("mouseleave", resumeAutoplay);
    slider.addEventListener("focusin", clearTimers);
    slider.addEventListener("focusout", (event) => {
      if (
        event.relatedTarget instanceof Node &&
        slider.contains(event.relatedTarget)
      )
        return;
      resumeAutoplay();
    });
    reducedMotion.addEventListener("change", startAutoplay);
    document.addEventListener("visibilitychange", startAutoplay);

    startAutoplay();
  });
</script>
