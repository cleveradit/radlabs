---
// Erlenmeyer kecil bergaris di latar seksi. Dipakai lewat slot `backdrop`
// milik Section: <Flasks slot="backdrop" items={...} />.
//
// x/y dalam persen bidang latar, ukuran dalam px, rotasi dalam derajat.
// `wide`: hanya tampil di ≥768px, supaya layar sempit tidak ramai.
interface Flask {
  x: number;
  y: number;
  size: number;
  rot: number;
  wide?: boolean;
}

interface Props {
  items: Flask[];
}

const { items } = Astro.props;
---

<div class="flasks" aria-hidden="true">
  {
    items.map((f) => (
      <svg
        class:list={["flask", f.wide && "flask-wide"]}
        width={f.size}
        height={Math.round((f.size * 32) / 24)}
        viewBox="0 0 24 32"
        style={`left:${f.x}%;top:${f.y}%;transform:translate(-50%,-50%) rotate(${f.rot}deg)`}
      >
        <path d="M8 2h8M10 2v9L3.6 26.2A2 2 0 0 0 5.3 29h13.4a2 2 0 0 0 1.7-2.8L14 11V2M6.1 20h11.8" />
      </svg>
    ))
  }
</div>
