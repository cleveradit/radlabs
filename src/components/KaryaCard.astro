---
import type { CollectionEntry } from "astro:content";

// Kartu proyek: notasi katalog → judul + panah → ringkasan → tag stack.
// Angka `metrics` tidak ikut di sini — tempatnya di halaman detail, di
// bawah lembar data, supaya kartu tetap ringkas seperti referensi.
interface Props {
  entry: CollectionEntry<"karya">;
  /* solo → kartu tunggal selebar container, cover ditampilkan di dalamnya
     grid → kartu ringkas dalam grid dua kolom, cover tidak ditampilkan */
  variant: "solo" | "grid";
}

const { entry, variant } = Astro.props;
const d = entry.data;

const href = `/karya/${d.slug}`;

// Notasi katalog — struktural, diturunkan dari `order` di frontmatter.
const catalog = `K-${String(d.order).padStart(2, "0")}`;
---

<article
  class="card group relative flex flex-col transition-colors focus-within:border-accent hover:border-accent"
>
  {/* Baris notasi. Di layar sempit bertumpuk supaya status yang panjang
      terbaca utuh — memotongnya akan menyembunyikan teks di balik tooltip
      `title`, yang tidak bisa dibuka di perangkat sentuh. */}
  <div
    class="u-mono mb-4 flex flex-col gap-1 text-[11px] tracking-[0.08em] text-muted min-[560px]:flex-row min-[560px]:items-center min-[560px]:gap-4"
  >
    <span class="shrink-0">{catalog}</span>
    <span class="flex min-w-0 items-center gap-1.5 min-[560px]:ml-auto">
      <span
        aria-hidden="true"
        class="size-[5px] shrink-0 rounded-full bg-accent"></span>
      <span class="min-[560px]:truncate" title={d.status}>{d.status}</span>
    </span>
  </div>

  <div class="flex items-start justify-between gap-4">
    <h3>
      {/* Tautan meregang menutupi seluruh kartu lewat ::after — menghindari
          <a> bersarang dengan tautan repo di bawah. */}
      <a
        href={href}
        class="text-ink no-underline after:absolute after:inset-0 after:content-['']"
        >{d.title}</a
      >
    </h3>
    <span
      aria-hidden="true"
      class="mt-1 shrink-0 text-muted transition-colors group-hover:text-accent"
      >↗</span
    >
  </div>

  <p class="mt-3 text-muted">{d.summary}</p>

  {
    variant === "solo" && (
      <div class="figure-frame mt-6">
        <img
          src={d.cover}
          alt={d.title}
          width="1920"
          height="961"
          {/* Gambar ini elemen LCP di layar lebar, jadi `eager` menolong
              sedikit di desktop — tapi di mobile ia ada jauh di bawah
              lipatan dan justru berebut bandwidth dengan jalur kritis.
              Mobile profil yang lebih ketat, jadi tetap `lazy`. */}
          loading="lazy"
          decoding="async"
          class="block w-full"
        />
      </div>
    )
  }

  <ul class="mt-6 flex flex-wrap gap-2">
    {d.stack.map((tag) => <li class="pill">{tag}</li>)}
  </ul>

  <div
    class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-line pt-4"
  >
    <span class="u-mono text-[11px] tracking-[0.08em] text-muted"
      >{d.period}</span
    >
    {
      d.repo ? (
        // z-10 mengangkatnya di atas tautan kartu yang meregang.
        <a
          href={d.repo}
          rel="noopener"
          class="u-mono relative z-10 ml-auto text-[11px] tracking-[0.08em] text-muted no-underline hover:text-accent hover:underline"
        >
          ↗ GitHub
        </a>
      ) : (
        <span class="u-mono ml-auto text-[11px] tracking-[0.08em] text-muted">
          Repositori privat
        </span>
      )
    }
  </div>
</article>
