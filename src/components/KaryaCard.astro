---
import type { CollectionEntry } from "astro:content";

// Layout adaptif (SPEC.md):
//   solo → satu kartu selebar container, cover ditampilkan di dalam kartu
//   grid → kartu ringkas dalam grid dua kolom, cover tidak ditampilkan
interface Props {
  entry: CollectionEntry<"karya">;
  variant: "solo" | "grid";
}

const { entry, variant } = Astro.props;
const d = entry.data;

// Semua metrics dirender, wrap bila perlu. Dibatasi 4 agar kartu tidak melar.
const METRICS_MAX = 4;
const metrics = d.metrics.slice(0, METRICS_MAX);

const href = `/karya/${d.slug}`;

// Notasi katalog — struktural, diturunkan dari `order` di frontmatter.
// Bukan data baru, jadi tidak perlu ditulis di content/.
const catalog = `K-${String(d.order).padStart(2, "0")}`;
---

<article
  class="group relative flex flex-col rounded-[var(--radius-card)] border border-line bg-surface p-6 transition-colors focus-within:border-accent hover:border-accent"
>
  {/* Baris notasi. Di layar sempit bertumpuk supaya status yang panjang
      terbaca utuh — memotongnya di sana akan menyembunyikan teks di balik
      tooltip `title`, yang tidak bisa dibuka di perangkat sentuh. */}
  <div
    class="u-mono mb-3 flex flex-col gap-1 text-[11px] tracking-[0.08em] text-muted min-[560px]:flex-row min-[560px]:items-center min-[560px]:gap-4"
  >
    <span class="shrink-0">{catalog}</span>
    <span class="flex min-w-0 items-center gap-1.5 min-[560px]:ml-auto">
      <span
        aria-hidden="true"
        class="size-[5px] shrink-0 rounded-full bg-accent"></span>
      <span class="min-[560px]:truncate" title={d.status}>{d.status}</span>
    </span>
  </div>

  <h3>
    {/* Tautan meregang menutupi seluruh kartu lewat ::after — menghindari <a> bersarang. */}
    <a
      href={href}
      class="text-ink no-underline after:absolute after:inset-0 after:content-['']"
      >{d.title}</a
    >
  </h3>

  <p class="mt-2 text-muted">{d.summary}</p>

  {
    variant === "solo" && (
      <div class="figure-frame mt-6">
        <img
          src={d.cover}
          alt={d.title}
          width="1920"
          height="961"
          {/* Gambar ini elemen LCP di layar lebar, jadi `eager` menolong
              sedikit di desktop — tapi di mobile ia ada jauh di bawah lipatan
              dan justru berebut bandwidth dengan jalur kritis (LCP 3,5s → 4,0s).
              Mobile profil yang lebih ketat, jadi tetap `lazy`. */}
          loading="lazy"
          decoding="async"
          class="block w-full"
        />
      </div>
    )
  }

  <ul class="mt-5 flex flex-wrap gap-1.5">
    {
      d.stack.map((tag) => (
        <li class="u-mono rounded-[var(--radius-tag)] border border-line px-2 py-0.5 text-[11px] text-muted">
          {tag}
        </li>
      ))
    }
  </ul>

  <div
    class="mt-5 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-t border-line pt-4"
  >
    <ul class="flex flex-wrap gap-x-6 gap-y-3">
      {
        metrics.map((m) => (
          <li>
            {/* Mono 13px, bukan serif 1.15rem — angka bukan judul, dan
                nilai `TODO` di content/ tidak boleh jadi teks terbesar
                di seksi ini (DESIGN.md, tabel skala). */}
            <p class="font-mono text-[13px] leading-tight font-medium tracking-[0.02em] text-accent">
              {m.value}
            </p>
            <p class="u-label mt-1">{m.label}</p>
          </li>
        ))
      }
    </ul>

    {
      d.repo ? (
        // z-10 mengangkatnya di atas tautan kartu yang meregang.
        <a
          href={d.repo}
          rel="noopener"
          class="u-mono relative z-10 shrink-0 text-[11px] tracking-[0.08em] text-muted no-underline hover:text-accent hover:underline"
        >
          ↗ GitHub
        </a>
      ) : (
        <p class="u-mono shrink-0 text-[11px] tracking-[0.08em] text-muted">
          Repositori privat
        </p>
      )
    }
  </div>
</article>
