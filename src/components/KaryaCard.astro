---
import type { CollectionEntry } from "astro:content";

// Layout adaptif (SPEC.md):
//   solo → satu kartu selebar container, cover ditampilkan di dalam kartu
//   grid → kartu ringkas dalam grid dua kolom, cover tidak ditampilkan
interface Props {
  entry: CollectionEntry<"karya">;
  variant: "solo" | "grid";
}

const { entry, variant } = Astro.props;
const d = entry.data;

// Semua metrics dirender, wrap bila perlu. Dibatasi 4 agar kartu tidak melar.
const METRICS_MAX = 4;
const metrics = d.metrics.slice(0, METRICS_MAX);

const href = `/karya/${d.slug}`;
---

<article
  class="group relative flex flex-col rounded-[var(--radius-card)] border border-line bg-surface p-6 transition-colors focus-within:border-accent hover:border-accent"
>
  <h3>
    {/* Tautan meregang menutupi seluruh kartu lewat ::after — menghindari <a> bersarang. */}
    <a
      href={href}
      class="text-ink no-underline after:absolute after:inset-0 after:content-['']"
      >{d.title}</a
    >
  </h3>

  <p class="mt-2 text-muted">{d.summary}</p>

  {
    variant === "solo" && (
      <div class="figure-frame mt-6">
        <img
          src={d.cover}
          alt={d.title}
          width="1920"
          height="961"
          loading="lazy"
          decoding="async"
          class="block w-full"
        />
      </div>
    )
  }

  <ul class="mt-5 flex flex-wrap gap-1.5">
    {
      d.stack.map((tag) => (
        <li class="u-mono rounded-[var(--radius-tag)] border border-line px-2 py-0.5 text-[11px] text-muted">
          {tag}
        </li>
      ))
    }
  </ul>

  <div
    class="mt-5 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-t border-line pt-4"
  >
    <ul class="flex flex-wrap gap-x-6 gap-y-3">
      {
        metrics.map((m) => (
          <li>
            <p class="font-serif text-[1.15rem] leading-tight font-medium text-accent">
              {m.value}
            </p>
            <p class="u-label mt-1">{m.label}</p>
          </li>
        ))
      }
    </ul>

    {
      d.repo ? (
        // z-10 mengangkatnya di atas tautan kartu yang meregang.
        <a
          href={d.repo}
          rel="noopener"
          class="u-mono relative z-10 shrink-0 text-[11px] tracking-[0.08em] text-muted no-underline hover:text-accent hover:underline"
        >
          ↗ GitHub
        </a>
      ) : (
        <p class="u-mono shrink-0 text-[11px] tracking-[0.08em] text-muted">
          Repositori privat
        </p>
      )
    }
  </div>
</article>
