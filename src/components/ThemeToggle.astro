---
// Simbol menyebut tema TUJUAN: matahari saat sedang gelap, bulan saat
// sedang terang. Pemilihan simbol dilakukan lewat CSS (lihat global.css)
// agar tidak ada kedipan dan tetap benar ketika JavaScript dimatikan.
interface Props {
  toLight: string;
  toDark: string;
}

const { toLight, toDark } = Astro.props;
---

<button type="button" id="theme-toggle" class="icon-btn">
  {/*
    Simbolnya aria-hidden; nama aksesibel datang dari teks sr-only di
    span yang sedang tampil. Span yang disembunyikan CSS (display: none)
    ikut keluar dari pohon aksesibilitas, jadi namanya selalu cocok
    dengan simbol yang terlihat.
  */}
  <span data-theme-label="dark">
    <svg
      aria-hidden="true"
      class="block"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
    >
      <circle cx="8" cy="8" r="3"></circle>
      <path
        d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M3.05 12.95l1.13-1.13M11.82 4.18l1.13-1.13"
      ></path>
    </svg>
    <span class="sr-only">{toLight}</span>
  </span>
  <span data-theme-label="light">
    <svg
      aria-hidden="true"
      class="block"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
    >
      <path d="M13.5 9.6A5.6 5.6 0 1 1 6.4 2.5a4.4 4.4 0 0 0 7.1 7.1z"></path>
    </svg>
    <span class="sr-only">{toDark}</span>
  </span>
</button>

<script>
  // Dijalankan di setiap `astro:page-load`: View Transitions menukar
  // tombol ini dengan yang baru tanpa memuat ulang script.
  document.addEventListener("astro:page-load", () => {
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
    });
  });
</script>
