---
// Simbol menyebut tema TUJUAN: matahari saat sedang gelap, bulan saat
// sedang terang. Pemilihan simbol dilakukan lewat CSS (lihat global.css)
// agar tidak ada kedipan dan tetap benar ketika JavaScript dimatikan.
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex size-7 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent"
>
  {/*
    Simbolnya aria-hidden; nama aksesibel datang dari teks sr-only di
    span yang sedang tampil. Span yang disembunyikan CSS (display: none)
    ikut keluar dari pohon aksesibilitas, jadi namanya selalu cocok
    dengan simbol yang terlihat.
  */}
  <span data-theme-label="dark">
    <svg
      aria-hidden="true"
      class="block"
      width="15"
      height="15"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
    >
      <circle cx="8" cy="8" r="3"></circle>
      <path
        d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M3.05 12.95l1.13-1.13M11.82 4.18l1.13-1.13"
      ></path>
    </svg>
    <span class="sr-only">Ganti ke tema terang</span>
  </span>
  <span data-theme-label="light">
    <svg
      aria-hidden="true"
      class="block"
      width="15"
      height="15"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
    >
      <path d="M13.5 9.6A5.6 5.6 0 1 1 6.4 2.5a4.4 4.4 0 0 0 7.1 7.1z"></path>
    </svg>
    <span class="sr-only">Ganti ke tema gelap</span>
  </span>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var root = document.documentElement;
      var next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
    });
  })();
</script>
