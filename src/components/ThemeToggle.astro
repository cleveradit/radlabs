---
// Label menyebut tema TUJUAN: "Terang" saat sedang gelap.
// Pemilihan label dilakukan lewat CSS (lihat global.css) agar tidak
// ada kedipan dan tetap benar ketika JavaScript dimatikan.
---

<button
  type="button"
  id="theme-toggle"
  class="u-mono inline-flex items-center rounded-[var(--radius-tag)] border border-line px-2.5 py-1 uppercase tracking-[0.1em] text-[11px] text-muted transition-colors hover:border-accent hover:text-accent"
>
  {/*
    Awalan hanya untuk pembaca layar, bukan aria-label statis: nama aksesibel
    jadi "Ganti ke tema Terang" dan tetap memuat teks yang terlihat. Sebuah
    aria-label tetap akan bentrok dengan label yang berubah-ubah dan memicu
    temuan label-content-name-mismatch.
  */}
  <span class="sr-only">Ganti ke tema </span>
  <span data-theme-label="dark">Terang</span>
  <span data-theme-label="light">Gelap</span>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var root = document.documentElement;
      var next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
    });
  })();
</script>
