---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Manifest from "../../components/Manifest.astro";

export const getStaticPaths = (async () => {
  const karya = await getCollection("karya");
  return karya.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// Urutan baris sesuai SPEC.md.
const rows = [
  { label: "Peran", value: d.role },
  { label: "Tim", value: d.team },
  { label: "Periode", value: d.period },
  { label: "Status", value: d.status },
  { label: "Stack", value: d.stack.join(", ") },
  d.repo
    ? { label: "Repo", value: "↗ GitHub", href: d.repo }
    : { label: "Repo", value: "Repositori privat" },
];
---

<Base title={d.title} description={d.summary} ogImage={d.cover}>
  <article>
    {/* Kepala halaman memakai kisi yang sama seperti hero landing supaya
        kedua halaman terasa satu sistem. */}
    <div class="lab-grid">
      <div class="container-page pt-[64px] pb-[56px]">
        <h1>{d.title}</h1>
        <p class="lede mt-5">{d.summary}</p>

        <Manifest rows={rows} caption="Lembar data" class="mt-10" />
      </div>
    </div>

    <div class="container-page pb-[56px]">
      <div class="prose">
        <Content />
      </div>

      <div
        class="rule-ticks mt-[var(--spacing-section)] border-t border-line pt-6"
      >
        <a
          href="/#karya"
          class="u-mono text-[11px] tracking-[0.1em] text-muted uppercase no-underline hover:text-accent"
          >← Semua karya</a
        >
      </div>
    </div>
  </article>
</Base>
