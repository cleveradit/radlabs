---
import Base from "../layouts/Base.astro";
import { frontmatter as site } from "../../content/id/site.md";
---

<Base title={site.notFound.heading} description={site.notFound.body}>
  <div class="lab-grid">
    <div class="container-page pt-[80px] pb-[var(--spacing-section)]">
      <h1>{site.notFound.heading}</h1>
      <p class="lede mt-5">{site.notFound.body}</p>

      <p class="mt-9">
        <a href="/" class="btn btn-outline">{site.notFound.backLabel}</a>
      </p>
    </div>
  </div>
</Base>
