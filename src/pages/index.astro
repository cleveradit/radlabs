---
import { existsSync } from "node:fs";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import PenelitianSlider from "../components/PenelitianSlider.astro";
import Flasks from "../components/Flasks.astro";
import { frontmatter as site } from "../../content/id/site.md";

const penelitian = (await getCollection("penelitian")).sort(
  (a, b) => a.data.order - b.data.order,
);

const roles = site.hero.roles as string[];
const pad = (n: number) => String(n).padStart(2, "0");

// Erlenmeyer di latar seksi (lihat Flasks.astro). Tentang: sebagian
// besar di pita kosong atas dan bawah, karena isinya di tengah secara
// vertikal. Pengalaman: di tepi kiri dan kanan, di luar lebar timeline.
const tentangFlasks = [
  { x: 62, y: 9, size: 40, rot: -12, wide: true },
  { x: 77, y: 17, size: 26, rot: 8, wide: true },
  { x: 90, y: 7, size: 46, rot: -4 },
  { x: 5, y: 86, size: 32, rot: 10 },
  { x: 21, y: 92, size: 24, rot: -8, wide: true },
  { x: 47, y: 85, size: 42, rot: 4, wide: true },
  { x: 84, y: 88, size: 34, rot: -14 },
];

const pengalamanFlasks = [
  { x: 4, y: 18, size: 34, rot: -10 },
  { x: 8, y: 52, size: 24, rot: 12, wide: true },
  { x: 3, y: 84, size: 42, rot: 6, wide: true },
  { x: 96, y: 14, size: 40, rot: 8, wide: true },
  { x: 92, y: 46, size: 26, rot: -14, wide: true },
  { x: 96, y: 80, size: 36, rot: -6 },
];

// Keahlian: kartu memenuhi lebar container, jadi erlenmeyer hanya di
// pita kosong samping judul dan di tepi kiri-kanan.
const keahlianFlasks = [
  { x: 55, y: 9, size: 38, rot: -10 },
  { x: 71, y: 15, size: 24, rot: 12, wide: true },
  { x: 88, y: 8, size: 44, rot: -4 },
  { x: 4, y: 42, size: 30, rot: 8, wide: true },
  { x: 96, y: 56, size: 34, rot: -12, wide: true },
  { x: 3, y: 84, size: 40, rot: 6, wide: true },
  { x: 97, y: 90, size: 26, rot: -8, wide: true },
];

// Penelitian: slider memenuhi lebar container; erlenmeyer di pita
// samping judul, di tepi kiri-kanan, dan di pita bawah.
const penelitianFlasks = [
  { x: 55, y: 9, size: 36, rot: -8 },
  { x: 72, y: 16, size: 24, rot: 12, wide: true },
  { x: 89, y: 8, size: 44, rot: -4 },
  { x: 4, y: 50, size: 30, rot: 10, wide: true },
  { x: 96, y: 46, size: 34, rot: -12, wide: true },
  { x: 9, y: 91, size: 38, rot: 6, wide: true },
  { x: 58, y: 93, size: 26, rot: -10, wide: true },
  { x: 91, y: 90, size: 40, rot: 4, wide: true },
];

// Aset opsional: dilewati kalau filenya belum ada, tanpa placeholder.
const ogImage = existsSync("public/images/og.png") ? "/images/og.png" : undefined;

type Action = { label: string; href: string; variant: "primary" | "outline" };
type Pengalaman = {
  role: string;
  org: string;
  period: string;
  status: string;
  summary: string;
  points: string[];
};
type Pendidikan = {
  title: string;
  org: string;
  period: string;
  note?: string;
  href?: string;
};
type Keahlian = { title: string; items: string[] };
---

<Base ogImage={ogImage} showNavLinks>
  <!-- Hero -->
  <div class="hero lab-grid">
    <p class="hero-backdrop" aria-hidden="true">{site.hero.backdrop}</p>

    <div class="container-page hero-inner">
      <div class="hero-top">
        <p class="u-eyebrow">{site.hero.eyebrow}</p>

        {/*
          Semua peran dirender di server dan ditumpuk di satu sel grid;
          tanpa JS yang terlihat peran pertama. Pembaca layar membaca
          daftar lengkap dari teks sr-only, bukan dari animasinya.
        */}
        <div class="hero-roles" data-hero-roles>
          <p class="sr-only">{roles.join(" · ")}</p>
          <ul class="hero-roles-list" aria-hidden="true">
            {
              roles.map((role, i) => {
                const [head, ...rest] = role.split(" ");
                return (
                  <li class:list={["hero-role", i === 0 && "is-active"]}>
                    <span class="block text-ink">{head}</span>
                    <span class="block text-accent">{rest.join(" ")}</span>
                  </li>
                );
              })
            }
          </ul>
          <p class="hero-roles-count u-mono" aria-hidden="true">
            <span data-hero-roles-index>{pad(1)}</span> / {pad(roles.length)}
          </p>
        </div>
      </div>

      <div class="hero-bottom">
        <div class="min-w-0">
          <h1 class="hero-name">{site.hero.name}</h1>
          <p class="hero-lede u-mono">{site.hero.lede}</p>
        </div>

        <div class="flex shrink-0 flex-wrap gap-3">
          {
            (site.hero.actions as Action[]).map((action) => (
              <a
                href={action.href}
                class:list={[
                  "btn",
                  action.variant === "primary" ? "btn-primary" : "btn-outline",
                ]}
              >
                {action.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var root = document.querySelector("[data-hero-roles]");
      if (!root) return;
      var items = root.querySelectorAll(".hero-role");
      if (items.length < 2) return;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      var index = root.querySelector("[data-hero-roles-index]");
      var current = 0;
      var timer = null;

      function show(next) {
        items[current].classList.remove("is-active");
        current = next;
        items[current].classList.add("is-active");
        if (index) index.textContent = String(current + 1).padStart(2, "0");
      }

      function start() {
        if (timer) return;
        timer = setInterval(function () {
          show((current + 1) % items.length);
        }, 3000);
      }

      function stop() {
        clearInterval(timer);
        timer = null;
      }

      // Berhenti saat ditunjuk kursor dan saat tab tidak terlihat.
      root.addEventListener("mouseenter", stop);
      root.addEventListener("mouseleave", function () {
        if (!document.hidden) start();
      });
      document.addEventListener("visibilitychange", function () {
        if (document.hidden) stop();
        else start();
      });

      start();
    })();
  </script>

  <!-- 01 — Tentang -->
  <Section title={site.tentang.title} index={1} id="tentang" alt fullscreen>
    <Flasks slot="backdrop" items={tentangFlasks} />

    <div class="space-y-4">
      {
        (site.tentang.paragraphs as string[]).map((text) => (
          <p class="text-muted">{text}</p>
        ))
      }
    </div>

    <h3 class="u-label mt-9 mb-3">{site.tentang.pendidikan.title}</h3>
    <ul class="grid gap-5 min-[720px]:grid-cols-2">
      {
        (site.tentang.pendidikan.items as Pendidikan[]).map((item) => (
          <li class="card">
            <h3>{item.title}</h3>
            <p class="mt-1 text-[0.98rem] text-ink">{item.org}</p>
            <p class="u-mono mt-1.5 text-[11px] tracking-[0.08em] text-muted">
              {item.period}
            </p>
            {item.note && <p class="mt-3 text-muted">{item.note}</p>}
            {item.href && (
              <p class="mt-3">
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="u-mono text-[11px] tracking-[0.08em] no-underline hover:underline"
                >
                  ↗ Verifikasi
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- 02 — Pengalaman -->
  <Section
    title={site.pengalaman.title}
    index={2}
    id="pengalaman"
    stickyTitle
  >
    <Flasks slot="backdrop" items={pengalamanFlasks} />

    <ol class="timeline space-y-10">
      {
        (site.pengalaman.items as Pengalaman[]).map((job) => (
          <li class="relative">
            <span class="timeline-marker" aria-hidden="true" />

            <h3>{job.role}</h3>
            <p class="mt-1 text-[0.98rem] text-ink">{job.org}</p>

            <p class="u-mono mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] tracking-[0.08em] text-muted">
              <span>{job.period}</span>
              {job.status && (
                <span class="flex items-center gap-1.5">
                  <span
                    aria-hidden="true"
                    class="size-[5px] shrink-0 rounded-full bg-accent"
                  />
                  {job.status}
                </span>
              )}
            </p>

            {job.summary && <p class="mt-3 text-muted">{job.summary}</p>}

            {job.points.length > 0 && (
              <ul class="mt-3 space-y-2 pl-[1.15em]">
                {job.points.map((point) => (
                  <li class="relative text-muted">
                    <span
                      aria-hidden="true"
                      class="absolute -left-[1.15em] text-muted"
                    >
                      —
                    </span>
                    {point}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- 03 — Keahlian -->
  <Section
    title={site.keahlian.title}
    index={3}
    id="keahlian"
    alt
    fullscreen
  >
    <Flasks slot="backdrop" items={keahlianFlasks} />

    <ul class="keahlian-grid">
      {
        (site.keahlian.groups as Keahlian[]).map((group) => (
          <li class="card keahlian-card">
            <h3>{group.title}</h3>
            <ul class="keahlian-pills">
              {group.items.map((item) => (
                <li class="pill">{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- 04 — Penelitian -->
  <Section
    title={site.penelitian.title}
    index={4}
    id="penelitian"
    fullscreen
  >
    <Flasks slot="backdrop" items={penelitianFlasks} />

    {site.penelitian.intro && <p class="lede -mt-4 mb-8">{site.penelitian.intro}</p>}

    {/* my-auto: di seksi setinggi layar intro tetap menempel ke judul,
        hanya slider yang ditengahkan di sisa ruang. */}
    <div class="my-auto">
      <PenelitianSlider entries={penelitian} label={site.penelitian.title} />
    </div>
  </Section>

  <!-- 05 — Kontak -->
  <Section title={site.kontak.title} index={5} id="kontak" alt>
    {site.kontak.intro && <p class="lede -mt-4 mb-8">{site.kontak.intro}</p>}

    <ul class="flex flex-wrap gap-4">
      {
        site.kontak.links.map(
          (link: { label: string; value: string; href: string }) => (
            <li>
              <a
                href={link.href}
                rel="noopener"
                class="card flex flex-col gap-1 px-6 py-4 no-underline transition-colors hover:border-accent"
              >
                <span class="u-label">{link.label}</span>
                <span class="font-mono text-[13px] text-ink">{link.value}</span>
              </a>
            </li>
          ),
        )
      }
    </ul>
  </Section>
</Base>
