---
import { existsSync } from "node:fs";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Manifest from "../components/Manifest.astro";
import KaryaCard from "../components/KaryaCard.astro";
import { frontmatter as site } from "../../content/id/site.md";

const karya = (await getCollection("karya")).sort(
  (a, b) => a.data.order - b.data.order,
);

// 1 item → kartu tunggal selebar container; 2+ → grid dua kolom (SPEC.md).
const variant = karya.length === 1 ? "solo" : "grid";

// Aset opsional: dilewati kalau filenya belum ada, tanpa placeholder.
const photo = existsSync(`public${site.tentang.photo}`) ? site.tentang.photo : null;
const ogImage = existsSync("public/images/og.png") ? "/images/og.png" : undefined;
---

<Base ogImage={ogImage}>
  <!-- 1 — Hero -->
  <div class="container-page pt-[64px] pb-[56px]">
    <h1>{site.hero.heading}</h1>
    <p class="lede mt-5">{site.hero.lede}</p>
    <Manifest rows={site.manifest} class="mt-10" />
  </div>

  <!-- 2 — Karya -->
  <Section eyebrow={site.karya.eyebrow}>
    <div
      class:list={[
        "grid gap-5",
        variant === "grid" && "min-[720px]:grid-cols-2",
      ]}
    >
      {karya.map((entry) => <KaryaCard entry={entry} variant={variant} />)}
    </div>
  </Section>

  <!-- 3 — Cara saya bekerja -->
  <Section eyebrow={site.caraKerja.eyebrow}>
    <ol class="grid gap-8 min-[560px]:grid-cols-2">
      {
        site.caraKerja.steps.map(
          (step: { title: string; body: string }, i: number) => (
            <li>
              <p class="u-mono text-[11px] tracking-[0.14em] text-accent">
                {String(i + 1).padStart(2, "0")}
              </p>
              <h3 class="mt-2">{step.title}</h3>
              <p class="mt-2 text-muted">{step.body}</p>
            </li>
          ),
        )
      }
    </ol>
  </Section>

  <!-- 4 — Tentang -->
  <Section eyebrow={site.tentang.eyebrow}>
    <div class="flex flex-col gap-6 min-[560px]:flex-row min-[560px]:items-start">
      {
        photo && (
          <img
            src={photo}
            alt=""
            width="96"
            height="96"
            loading="lazy"
            decoding="async"
            class="h-24 w-24 shrink-0 rounded-[var(--radius-card)] border border-line object-cover"
          />
        )
      }
      <p>{site.tentang.body}</p>
    </div>
  </Section>

  <!-- 5 — Kontak -->
  <Section eyebrow={site.kontak.eyebrow}>
    {site.kontak.intro && <p class="lede">{site.kontak.intro}</p>}

    <dl class="manifest mt-6">
      {
        site.kontak.links.map(
          (link: { label: string; value: string; href: string }) => (
            <div class="manifest-row">
              <dt class="manifest-label">{link.label}</dt>
              <dd class="manifest-value">
                <a href={link.href} rel="noopener" class="no-underline hover:underline">
                  {link.value}
                </a>
              </dd>
            </div>
          ),
        )
      }
    </dl>
  </Section>
</Base>
